  "steps": [
    "Preheat the oven to 400°F and line baking sheets with parchment paper.",
    "Beat the sugar, butter and eggs with a mixer until light and creamy.",
    "Mix in the flour, cream of tartar, baking soda and salt only until no dry flour remains.",
    "Stir the 2 tbsp sugar and cinnamon together in a small bowl. Roll the dough into 1 1/4-inch balls and roll each in the cinnamon sugar.",
    "Set 2 inches apart and bake 7 minutes, until set at the edges with soft, puffed centers.",
    "Cool 2 minutes on the sheet, then move to a wire rack."
  ],
  "tips": [
    "Betty Crocker bakes these 8 to 10 minutes; at 7 they stay softer in the middle."
  ],
