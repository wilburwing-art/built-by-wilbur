  "steps": [
    "Preheat the air fryer to 400°F.",
    "Whisk the chili crunch, honey, rice vinegar, sesame oil and salt in a large bowl. Add the salmon cubes and toss until coated.",
    "Oil the bottom of the air fryer basket and add the salmon in a single layer, working in batches if needed. Drizzle with the avocado oil.",
    "Cook 6 to 8 min, until the outside starts to brown and the salmon reads 145°F inside.",
    "While the salmon cooks, mix the edamame, green onions, sesame oil, rice vinegar, salt, sesame seeds and lime juice in a bowl.",
    "Build bowls with rice, salmon and edamame salad. Top with avocado, cilantro, extra chili crunch and Kewpie mayo if you like."
  ],
  "tips": [
    "Do not stack the salmon in the basket, or it steams instead of browning.",
    "If your edamame is frozen, thaw it in cool water so it does not turn slimy."
  ],
